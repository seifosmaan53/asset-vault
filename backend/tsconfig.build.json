{
  "extends": "./tsconfig.json",
  /* Without an explicit rootDir, tsc infers one from every file it compiles. It was
     picking up scripts/*.ts alongside src/, so the common root became the package
     directory and the build emitted dist/src/main.js — while `start:prod` runs
     `node dist/main`. Production start had therefore never worked from a clean build.
     Pinning rootDir to src puts main.js back at dist/main.js, which is both the Nest
     convention and what the script already expects.

     `include` is explicit too: with only an `exclude` list, tsc resolved no inputs at
     all and `nest build` exited 0 having emitted nothing. */
  "compilerOptions": {
    "rootDir": "./src",
    /* Keep the incremental cache inside dist. It defaulted to the package root, so
       `rm -rf dist` left it behind: tsc then believed the output was current, emitted
       nothing, and still exited 0 — a clean rebuild that silently produced no app. */
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*.spec.ts"]
}
