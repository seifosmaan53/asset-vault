# Asset Vault — Backend Environment Configuration
# Copy this file to .env and fill in real values.
#
# The names and requirements below mirror the Joi schema in src/app.module.ts.
# Anything marked REQUIRED is validated at boot: if it is missing the process exits
# with "Config validation error" rather than starting.

# ============================================
# REQUIRED
# ============================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Default when unset is "invoiceme" — the pre-v2.0.0 name, kept so existing
# deployments keep pointing at their real database. New installs can use any name.
DB_DATABASE=asset_vault

# Clerk handles authentication. The API will NOT BOOT without this key.
# Create an application at https://dashboard.clerk.com and copy the SECRET key
# (starts with sk_test_ for development, sk_live_ for production).
# The matching publishable key goes in frontend/.env as VITE_CLERK_PUBLISHABLE_KEY.
CLERK_SECRET_KEY=sk_test_replace_me

# ============================================
# OPTIONAL (defaults shown)
# ============================================

NODE_ENV=development
PORT=3000

# Used for CORS and for links inside outgoing email
FRONTEND_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Reverse proxies whose X-Forwarded-* headers are trusted: a hop count (1) or a list of
# IPs/CIDRs/loopback/linklocal/uniquelocal. Empty = trust none (direct exposure).
# `true` and `*` are refused. The Compose TLS stack sets 1. See docs/setup/DOCKER_README.md.
TRUST_PROXY=
# Optional public origin of the API (https://api.example.com). The HTTP->HTTPS redirect
# targets this host (falls back to FRONTEND_URL); it is never taken from the Host header.
API_PUBLIC_URL=
# Bound for draining in-flight requests on SIGTERM before a forced exit (1000-120000 ms).
SHUTDOWN_TIMEOUT_MS=8000

# POST /user-settings/test-email (SMTP connection test) limits. Counts are PER PROCESS (the
# throttler's in-memory store); with N replicas a client can get up to N times these numbers.
# Per verified user per minute / per hour; per client address per minute (as TRUST_PROXY sees it);
# tests in flight at once in this process (one per user); whole-test deadline (1000-120000 ms).
SMTP_TEST_LIMIT_PER_MINUTE=5
SMTP_TEST_LIMIT_PER_HOUR=20
SMTP_TEST_IP_LIMIT_PER_MINUTE=20
SMTP_TEST_MAX_CONCURRENT=8
SMTP_TEST_TIMEOUT_MS=10000

# Verifies Clerk webhook signatures. Only needed if you point Clerk webhooks here
# (that is what creates users in the database on sign-up).
# Optional. PEM public key from the Clerk dashboard (API keys -> JWT public key). When set, session tokens
# are verified without a network call to Clerk's JWKS endpoint. Tokens are ALWAYS signature-verified either way.
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=

# ============================================
# OPTIONAL: Email (SMTP)
# ============================================
# Leave blank to disable email sending entirely.
#
#   Gmail:     SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  SMTP_PASS=<app password>
#   SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Asset Vault <no-reply@your-domain.com>"

# ============================================
# OPTIONAL: Stripe billing
# ============================================
# Subscription features stay dormant unless these are set.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ============================================
# OPTIONAL: AWS (backup storage)
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================
# OPTIONAL: Network access control
# ============================================
# Comma-separated CIDR ranges or addresses. Empty means no restriction.
IP_WHITELIST=
IP_BLACKLIST=

# ============================================
# PRODUCTION NOTES
# ============================================
# 1. Use live Clerk keys and a strong database password.
# 2. Set NODE_ENV=production.
# 3. Point FRONTEND_URL at your real domain so CORS and email links are correct.
# 4. Never commit .env — only this example belongs in git.
#
# NOTE: JWT_SECRET / JWT_REFRESH_SECRET used to be listed here as required. They are
# not read by the running application any more — authentication moved to Clerk — so
# they have been removed to stop them being set under the illusion they do something.
