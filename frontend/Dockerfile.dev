FROM node:18-alpine

WORKDIR /app

# Build context: the repository root (see docker-compose.yml). Source, and the
# invoice-money module shared with the API, are mounted as volumes.
# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Expose Vite dev server port
EXPOSE 5173

# Start dev server (command will be overridden by docker-compose)
CMD ["npm", "run", "dev"]

