# Used by the frontend images, whose build context is the repository root so they
# can include the invoice-money module shared with the API
# (backend/src/common/money/invoice-money.ts). The backend image builds from ./backend.
*
!frontend/
!backend/src/common/money/invoice-money.ts
frontend/node_modules
frontend/dist
frontend/coverage
# Every env file is excluded except the committed example and the production file
# (which a builder may use to supply build-time values such as the publishable key).
frontend/.env*
!frontend/.env.example
!frontend/.env.production
frontend/**/*.test.ts
frontend/**/*.test.tsx
frontend/**/*.log
frontend/.DS_Store
